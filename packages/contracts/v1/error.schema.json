{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smart-uni:contracts:v1:error",
  "title": "SMART UNI v1 - stable error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code",
    "message"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "code": {
      "type": "string",
      "enum": [
        "VALIDATION_ERROR",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "NOT_FOUND",
        "CONFLICT",
        "UNSUPPORTED_VERSION",
        "DATA_CORRUPT"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "details": {
      "type": "object"
    }
  }
}
